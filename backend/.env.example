# Backend database
DATABASE_URL=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# Backend auth
JWT_SECRET=replace_with_a_long_random_secret_key

# Local backend port
PORT=3030

# Allowed frontend origins (comma separated)
CORS_ORIGIN=http://localhost:5173,https://your-frontend-app.vercel.app,https://your-custom-domain.com

# Frontend app URL used in emails or redirects
FRONTEND_URL=https://your-frontend-app.vercel.app

# Email sender credentials
EMAIL_USER=
EMAIL_PASS=
