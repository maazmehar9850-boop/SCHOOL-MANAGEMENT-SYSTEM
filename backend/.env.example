# Backend database
DATABASE_URL=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# Backend auth
JWT_SECRET=replace_with_a_long_random_secret_key

# Local backend port
PORT=3030

# Allowed frontend origins (comma separated)
CORS_ORIGIN=http://localhost:5173,https://cms-maaz.vercel.app

# Frontend app URL used in emails or redirects
FRONTEND_URL=https://cms-maaz.vercel.app

CONTACT_EMAIL=maazmehar9850@gmail.com

# Gmail sender (must be the same Google account)
# EMAIL_USER = your Gmail address
# EMAIL_PASS = 16-digit App Password (Google Account → Security → 2-Step Verification → App passwords)
# Do NOT use your normal Gmail password.
EMAIL_USER=maazmehar9850@gmail.com
EMAIL_PASS=
